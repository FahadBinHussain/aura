<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aura.Views.Backiee.CategoryWallpapersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aura.Views"
    xmlns:converters="using:Aura.Converters"
    xmlns:models="using:Aura.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:Microsoft.UI.Xaml"
    xmlns:data="using:Microsoft.UI.Xaml.Data"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Grid Grid.Row="0" Margin="24,24,24,8">
            <TextBlock x:Name="PageTitleTextBlock"
                       Text="Category"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Subcategory chips -->
        <Grid Grid.Row="1" Margin="24,0,24,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="ChipsScrollViewer"
                          Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <ItemsControl x:Name="ChipsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="ChipsStatusText"
                       Grid.Row="1"
                       Foreground="Orange"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Wallpaper grid with adaptive layout -->
        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ViewChanged="MainScrollViewer_ViewChanged"
                      Padding="0"
                      Margin="0">

            <GridView x:Name="WallpapersGridView"
                     Margin="12,8,12,12"
                     SelectionMode="None"
                     IsItemClickEnabled="True"
                     ItemClick="WallpapersGridView_ItemClick"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     ContainerContentChanging="WallpapersGridView_ContainerContentChanging">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="Auto"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </GridView.ItemContainerStyle>

                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid x:Name="WallpapersWrapGrid"
                                     Orientation="Horizontal"
                                     HorizontalAlignment="Stretch"
                                     ItemWidth="NaN"
                                     ItemHeight="NaN"
                                     SizeChanged="WallpapersWrapGrid_SizeChanged"
                                     MaximumRowsOrColumns="6"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              CornerRadius="12"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="0.5"
                              Margin="0"
                              Padding="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">

                            <!-- Wallpaper Image Container -->
                            <Image x:Name="ItemImage"
                                   Source="ms-appx:///Assets/placeholder-wallpaper-1000.png"
                                   Stretch="UniformToFill"
                                   CacheMode="BitmapCache"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>

                            <!-- Tag Overlays -->
                            <Grid Margin="0" Padding="0">
                                <!-- Quality Tag - Top Left -->
                                <Border x:Name="QualityTagBorder"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="0"
                                        Padding="0"
                                        Visibility="Collapsed">
                                    <Image x:Name="QualityImage" Width="90" Height="54" Margin="0" HorizontalAlignment="Left"/>
                                </Border>

                                <!-- AI Tag - Top Right -->
                                <Border x:Name="AITagBorder"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,0,8,0"
                                        Padding="0"
                                        Visibility="Collapsed">
                                    <Image x:Name="AIImage" Width="40" Height="40" Margin="0"/>
                                </Border>

                                <!-- Stats Container (Bottom Right) integrated with card -->
                                <Border CornerRadius="8,0,12,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <!-- Likes -->
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock x:Name="LikesText"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                            <FontIcon FontFamily="Segoe Fluent Icons"
                                                      Glyph="&#xEB52;"
                                                      FontSize="14"
                                                      Foreground="White"/>
                                        </StackPanel>

                                        <!-- Downloads -->
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock x:Name="DownloadsText"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                            <FontIcon FontFamily="Segoe Fluent Icons"
                                                      Glyph="&#xE896;"
                                                      FontSize="14"
                                                      Foreground="White"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>

        <!-- Error state -->
        <TextBlock x:Name="ErrorTextBlock"
                   Grid.Row="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   FontSize="15"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="24,0"
                   Visibility="Collapsed"/>

        <!-- Loading bar -->
        <ProgressBar x:Name="LoadingProgressBar"
                    Grid.Row="2"
                    VerticalAlignment="Bottom"
                    IsIndeterminate="True"
                    Height="3"
                    Margin="0,0,0,4"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="Orange"
                    Visibility="Collapsed"/>
    </Grid>
</Page>
